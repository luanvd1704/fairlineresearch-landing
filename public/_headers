# Header bảo mật cho mọi trang (Cloudflare đọc file này, không phát nó ra web)
/*
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# Thư viện dùng chung của dashboard: tên file có dấu vân tay nội dung, nội dung đổi thì tên đổi,
# nên trình duyệt giữ 1 năm mà không bao giờ dùng nhầm bản cũ
/lib/*
  Cache-Control: public, max-age=31536000, immutable
