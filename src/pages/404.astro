---
import Base from '../layouts/Base.astro';
---
<Base
  title="Không tìm thấy trang — Fairline Research"
  description="Trang bạn tìm không có hoặc đã được chuyển chỗ."
  chiMuc={false}
>

  <section class="page-hero page-hero--center">
    <div class="container">
      <p class="kicker">Lỗi 404</p>
      <h1>Không tìm thấy <em>trang này</em></h1>
      <p class="lead">Đường dẫn có thể đã đổi hoặc bị gõ nhầm. Bạn thử một trong hai trang dưới đây.</p>
      <div class="hero__cta" style="justify-content:center">
        <a class="btn btn--primary" href="/">Về trang chủ</a>
        <a class="btn btn--ghost" href="/phan-tich/">Xem các bài phân tích</a>
      </div>
    </div>
  </section>

</Base>
