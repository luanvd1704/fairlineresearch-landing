---
import Base from '../layouts/Base.astro';
import TheBai from '../components/TheBai.astro';
import { tatCaBai } from '../lib/bai-viet';

// Lưới "Bài phân tích mới nhất" có 2 cột: hiện 2 bài mới nhất, còn lại ở /phan-tich/
const moiNhat = (await tatCaBai()).slice(0, 2);
---
<Base
  title="Fairline Research — Định giá cổ phiếu Việt Nam"
  description="Nghiên cứu định giá độc lập cổ phiếu HOSE, HNX, UPCoM bằng DCF, so sánh bội số và thu nhập thặng dư — công bố mọi giả định."
>

<main id="top">

  {/* Đầu trang */}
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__copy">
        <p class="eyebrow">Nghiên cứu định giá độc lập · HOSE · HNX · UPCoM</p>
        <h1>Biết cổ phiếu đáng giá bao nhiêu <em>trước khi</em> mua.</h1>
        <p class="lead">Fairline dựng mô hình định giá từ báo cáo tài chính đã kiểm toán — chiết khấu dòng tiền, so sánh bội số, thu nhập thặng dư — và công bố cả khoảng giá trị lẫn mọi giả định đứng sau.</p>
        <div class="hero__cta">
          <a class="btn btn--mint" href="#phan-tich">Xem bài phân tích →</a>
          <a class="btn btn--glass" href="#calculator">Thử công cụ định giá</a>
        </div>
        <p class="fineprint">Đọc miễn phí · Không cần thẻ thanh toán</p>
      </div>

      <figure class="hero__card card">
        <figcaption class="chart-head">
          <div>
            <span class="ticker">ABC</span>
            <span class="muted">Giá thị trường so với giá trị hợp lý</span>
          </div>
          <span class="tag">Minh họa</span>
        </figcaption>
        <svg id="heroChart" class="hero-chart" viewBox="0 0 600 280" role="img"
             aria-label="Biểu đồ minh họa: giá thị trường dao động quanh đường giá trị hợp lý"></svg>
        <ul class="legend">
          <li><i class="sw sw--under"></i>Dưới giá trị hợp lý</li>
          <li><i class="sw sw--over"></i>Trên giá trị hợp lý</li>
          <li><i class="sw sw--fair"></i>Giá trị hợp lý</li>
        </ul>
        <dl class="hero__stats">
          <div><dt>Giá (đồng)</dt><dd>42.300</dd></div>
          <div><dt>Giá trị hợp lý (đồng)</dt><dd>51.800</dd></div>
          <div><dt>Biên an toàn</dt><dd class="pos">18,3%</dd></div>
        </dl>
      </figure>
    </div>
  </section>

  {/* Nguyên tắc */}
  <section class="principles" aria-label="Nguyên tắc">
    <div class="container principles__grid">
      <div>
        <span class="principle__icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4 6v6c0 4.5 3.4 8.2 8 9 4.6-.8 8-4.5 8-9V6z"/><path d="m9 12 2 2 4-4"/></svg></span>
        <h3>Độc lập</h3>
        <p>Không nhận phí từ doanh nghiệp được phân tích.</p>
      </div>
      <div>
        <span class="principle__icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8M8 12h8M8 16h5"/></svg></span>
        <h3>Minh bạch</h3>
        <p>Tải file Excel định giá và tự đổi bất kỳ giả định nào.</p>
      </div>
      <div>
        <span class="principle__icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19h16"/><path d="M7 15v-4M12 15V7M17 15v-6"/></svg></span>
        <h3>Chịu trách nhiệm</h3>
        <p>Mọi bản định giá cũ được giữ lại — kể cả những lần sai.</p>
      </div>
    </div>
  </section>

  {/* Phân tích */}
  <section id="phan-tich" class="section">
    <div class="container">
      <div class="panel">
        <div class="section__head section__head--row">
          <div>
            <p class="eyebrow">Phân tích cơ bản</p>
            <h2>Bài phân tích <em>mới nhất</em></h2>
          </div>
          <a class="btn btn--ghost btn--pill" href="phan-tich/">Xem tất cả →</a>
        </div>
        <div class="posts">
          {moiNhat.map((b) => <TheBai id={b.id} bai={b.data} kieu="trang-chu" />)}
        </div>
      </div>
    </div>
  </section>

  {/* Phương pháp */}
  <section id="methods" class="section section--alt">
    <div class="container">
      <div class="section__head">
        <p class="eyebrow">Phương pháp</p>
        <h2>Ba lăng kính, <em>một khoảng giá trị</em></h2>
        <p class="lead">Không phương pháp nào hợp với mọi doanh nghiệp. Chúng tôi chọn mô hình khớp với cách công ty kiếm tiền, rồi đối chiếu chéo để ra một khoảng giá trị đáng tin.</p>
      </div>

      <div class="methods">
        <article class="method card">
          <span class="method__num">01</span>
          <h3>Chiết khấu dòng tiền (DCF)</h3>
          <p>Dòng tiền tự do dự phóng 5–10 năm từ các động lực kinh doanh thật, chiết khấu bằng chi phí vốn phản ánh rủi ro thị trường Việt Nam.</p>
          <p class="method__fit">Hợp với: sản xuất, bán lẻ, tiện ích, công nghệ</p>
        </article>
        <article class="method card">
          <span class="method__num">02</span>
          <h3>So sánh bội số</h3>
          <p>P/E, P/B và EV/EBITDA so với doanh nghiệp cùng ngành trong nước và khu vực, điều chỉnh theo chênh lệch tăng trưởng và ROE.</p>
          <p class="method__fit">Hợp với: ngành có nhiều công ty niêm yết tương đồng</p>
        </article>
        <article class="method card">
          <span class="method__num">03</span>
          <h3>Thu nhập thặng dư (RI)</h3>
          <p>Giá trị bằng giá trị sổ sách cộng phần lợi nhuận vượt chi phí vốn chủ — chuẩn mực cho tài chính, nơi dòng tiền tự do ít ý nghĩa.</p>
          <p class="method__fit">Hợp với: ngân hàng, bảo hiểm, chứng khoán</p>
        </article>
      </div>

      <figure class="ff card" style="--min:30; --max:65">
        <figcaption class="ff__head">
          <div>
            <h3>Biểu đồ khoảng giá trị</h3>
            <p class="muted">Cổ phiếu ABC · nghìn đồng mỗi cổ phiếu</p>
          </div>
          <span class="tag">Minh họa</span>
        </figcaption>

        <div class="ff__plot">
          <div class="ff__row">
            <div class="ff__label">DCF (FCFF)<small>Trọng số 50%</small></div>
            <div class="ff__track"><div class="ff__bar" style="--lo:45.8; --hi:58.8"><span>45,8 – 58,8</span></div></div>
          </div>
          <div class="ff__row">
            <div class="ff__label">So sánh P/E<small>Trọng số 25%</small></div>
            <div class="ff__track"><div class="ff__bar" style="--lo:44; --hi:53.5"><span>44,0 – 53,5</span></div></div>
          </div>
          <div class="ff__row">
            <div class="ff__label">EV/EBITDA<small>Trọng số 25%</small></div>
            <div class="ff__track"><div class="ff__bar" style="--lo:47.5; --hi:60.2"><span>47,5 – 60,2</span></div></div>
          </div>
          <div class="ff__row">
            <div class="ff__label">So sánh P/B<small>Tham khảo</small></div>
            <div class="ff__track"><div class="ff__bar ff__bar--ref" style="--lo:39.8; --hi:50.1"><span>39,8 – 50,1</span></div></div>
          </div>
          <div class="ff__row">
            <div class="ff__label">Dải giá 52 tuần<small>Tham khảo</small></div>
            <div class="ff__track"><div class="ff__bar ff__bar--ref" style="--lo:33.1; --hi:46.8"><span>33,1 – 46,8</span></div></div>
          </div>
          <div class="ff__marker ff__marker--price" style="--v:42.3"><span>Giá 42,3</span></div>
          <div class="ff__marker ff__marker--fair" style="--v:51.8"><span>Giá trị hợp lý 51,8</span></div>
        </div>

        <div class="ff__axis" aria-hidden="true">
          <span style="--t:30">30</span><span style="--t:35">35</span><span style="--t:40">40</span><span style="--t:45">45</span>
          <span style="--t:50">50</span><span style="--t:55">55</span><span style="--t:60">60</span><span style="--t:65">65</span>
        </div>
        <p class="ff__note">Giá trị hợp lý = bình quân có trọng số của điểm giữa các khoảng: DCF 50% · P/E 25% · EV/EBITDA 25%. P/B và dải giá 52 tuần chỉ để tham khảo.</p>
      </figure>
    </div>
  </section>

  {/* Số liệu thị trường (market-charts.js điền từ data/market-data.js) */}
  <section id="market" class="section">
    <div class="container">
      <div class="section__head">
        <p class="eyebrow">Số liệu thị trường</p>
        <h2>Định giá thị trường Việt Nam <em>đang ở đâu</em></h2>
        <p class="lead">Tính từ P/E và P/B hằng ngày của <span id="coverage">300+</span> doanh nghiệp niêm yết trên HOSE, HNX và UPCoM. Số liệu đến ngày <span id="asOf">—</span>.</p>
      </div>

      <div class="stats">
        <div class="stat card">
          <p class="stat__label">P/E trung vị toàn thị trường</p>
          <p class="stat__value" id="statPe">—</p>
          <p class="stat__note" id="statPeNote"></p>
        </div>
        <div class="stat card">
          <p class="stat__label">Ngành có P/E dưới trung vị 5 năm</p>
          <p class="stat__value" id="statSectors">—</p>
          <p class="stat__note">Mỗi ngành so với chính lịch sử của nó</p>
        </div>
        <div class="stat card">
          <p class="stat__label">Ngân hàng có P/B dưới mức hợp lý</p>
          <p class="stat__value" id="statBanks">—</p>
          <p class="stat__note" id="statBanksNote"></p>
        </div>
      </div>

      <figure class="viz card viz--wide">
        <figcaption class="viz__head">
          <div>
            <h3>P/E thị trường từ 2018</h3>
            <p class="muted">P/E trượt trung vị của các doanh nghiệp có lãi, theo tháng</p>
          </div>
          <ul class="viz__legend">
            <li><i class="key key--line"></i>P/E trung vị</li>
            <li><i class="key key--band"></i>50% cổ phiếu ở giữa</li>
            <li><i class="key key--ref"></i>Trung bình từ 2018</li>
          </ul>
        </figcaption>
        <div class="viz__plot" id="vizMarket"></div>
        <details class="viz__table"><summary>Xem bảng số liệu</summary><div id="tableMarket"></div></details>
      </figure>

      <div class="viz-grid">
        <figure class="viz card">
          <figcaption class="viz__head">
            <div>
              <h3>P/E ngành so với lịch sử</h3>
              <p class="muted">P/E trung vị từng ngành hôm nay so với 5 năm qua</p>
            </div>
            <ul class="viz__legend">
              <li><i class="key key--dot"></i>Hôm nay</li>
              <li><i class="key key--tick"></i>Trung vị 5 năm</li>
              <li><i class="key key--range"></i>Dải 5 năm (phân vị 10–90)</li>
            </ul>
          </figcaption>
          <div class="viz__plot" id="vizSectors"></div>
          <details class="viz__table"><summary>Xem bảng số liệu</summary><div id="tableSectors"></div></details>
        </figure>

        <figure class="viz card">
          <figcaption class="viz__head">
            <div>
              <h3>Ngân hàng: trả bao nhiêu, lãi bao nhiêu</h3>
              <p class="muted" id="banksSub">ROE so với P/B, kèm P/B hợp lý theo thu nhập thặng dư</p>
            </div>
            <ul class="viz__legend">
              <li><i class="key key--dot"></i>Ngân hàng</li>
              <li><i class="key key--fair"></i>P/B hợp lý = (ROE − g) / (r − g)</li>
            </ul>
          </figcaption>
          <div class="viz__plot" id="vizBanks"></div>
          <details class="viz__table"><summary>Xem bảng số liệu</summary><div id="tableBanks"></div></details>
        </figure>
      </div>
      <p class="viz__source">Nguồn: cơ sở dữ liệu Fairline Research. P/E không tính doanh nghiệp lỗ. Chỉ để tham khảo — không phải khuyến nghị đầu tư.</p>
    </div>
  </section>

  {/* Công cụ định giá */}
  <section id="calculator" class="section section--alt">
    <div class="container">
      <div class="section__head">
        <p class="eyebrow">Công cụ định giá</p>
        <h2>Ước giá trị nội tại <em>trong 30 giây</em></h2>
        <p class="lead">Mô hình chiết khấu lợi nhuận hai giai đoạn: năm năm tăng trưởng cao, sau đó tăng đều dài hạn. Kéo thanh trượt để thấy giá trị nhạy thế nào với từng giả định.</p>
      </div>

      <div class="calc">
        <form class="calc__inputs card" id="calcForm" novalidate>
          <div class="field-pair">
            <div class="field">
              <label for="eps">EPS 4 quý <span class="unit">đồng</span></label>
              <input id="eps" type="number" inputmode="numeric" min="0" step="100" value="4200">
            </div>
            <div class="field">
              <label for="price">Giá thị trường <span class="unit">đồng</span></label>
              <input id="price" type="number" inputmode="numeric" min="0" step="100" value="42300">
            </div>
          </div>
          <div class="field">
            <div class="field__row"><label for="g1">Tăng trưởng EPS, 5 năm tới</label><output id="g1Out" for="g1"></output></div>
            <input id="g1" type="range" min="0" max="30" step="0.5" value="10">
          </div>
          <div class="field">
            <div class="field__row"><label for="g2">Tăng trưởng dài hạn (từ năm 6)</label><output id="g2Out" for="g2"></output></div>
            <input id="g2" type="range" min="0" max="7" step="0.5" value="4">
          </div>
          <div class="field">
            <div class="field__row"><label for="r">Lợi suất yêu cầu (chi phí vốn chủ)</label><output id="rOut" for="r"></output></div>
            <input id="r" type="range" min="9" max="20" step="0.5" value="14">
          </div>
          <p class="fineprint">Mô hình rút gọn: coi toàn bộ lợi nhuận là tiền cổ đông nhận được. Báo cáo đầy đủ dùng dòng tiền tự do và cơ cấu vốn thực tế.</p>
        </form>

        <div class="calc__result card" aria-live="polite">
          <p class="muted">Giá trị nội tại ước tính</p>
          <p class="big"><span id="value">—</span> <small>đồng/cổ phiếu</small></p>
          <p class="verdict" id="verdict"></p>

          <div class="gauge" id="gauge">
            <div class="gauge__track"></div>
            <div class="gauge__fill" id="gaugeFill"></div>
            <div class="gauge__mark gauge__mark--price" id="markPrice"><span></span></div>
            <div class="gauge__mark gauge__mark--value" id="markValue"><span></span></div>
          </div>

          <dl class="breakdown">
            <div><dt>Biên an toàn</dt><dd id="mos">—</dd></div>
            <div><dt>P/E ngầm định</dt><dd id="pe">—</dd></div>
            <div><dt>Hiện giá lợi nhuận 5 năm</dt><dd id="pvStage">—</dd></div>
            <div><dt>Hiện giá giá trị cuối kỳ</dt><dd id="pvTerminal">—</dd></div>
          </dl>

          <h4 class="sens__title">Độ nhạy <span class="muted">(nghìn đồng/cổ phiếu)</span></h4>
          <div class="sens__wrap">
            <table class="sens" id="sens"></table>
          </div>
          <p class="fineprint">Hàng: lợi suất yêu cầu · Cột: tăng trưởng dài hạn · Ô viền đậm: giả định đang chọn</p>
        </div>
      </div>
    </div>
  </section>

  {/* Phân bổ danh mục (market-charts.js vẽ biểu đồ) */}
  <section id="portfolio" class="section">
    <div class="container">
      <div class="section__head">
        <p class="eyebrow">Phân bổ danh mục</p>
        <h2>Từ giá trị hợp lý <em>đến tỷ trọng</em></h2>
        <p class="lead">Biết cổ phiếu đáng giá bao nhiêu mới là một nửa. Nửa còn lại là nên nắm bao nhiêu. Sáu cách phân bổ, mỗi cách một quan niệm khác về thế nào là “cân bằng”.</p>
      </div>

      <div class="am-grid">
        <article class="am card">
          <div class="am__top"><span class="am__num">1</span><h3>Trung bình – phương sai (Markowitz)</h3></div>
          <p>Tìm tổ hợp có lợi suất trên mỗi đơn vị rủi ro cao nhất trên đường biên hiệu quả. Mạnh, nhưng nhạy với ước tính lợi suất — dễ dồn tỷ trọng.</p>
          <code class="am__formula">max (wᵀμ − r<sub>f</sub>) / √(wᵀΣw)</code>
          <p class="am__needs">Cần: lợi suất kỳ vọng · hiệp phương sai</p>
        </article>
        <article class="am card">
          <div class="am__top"><span class="am__num">2</span><h3>Black-Litterman</h3></div>
          <p>Bắt đầu từ lợi suất mà thị trường ngầm định, rồi nghiêng theo quan điểm — chính là ước tính giá trị hợp lý — tùy mức tin cậy. Ổn định hơn Markowitz thuần.</p>
          <code class="am__formula">π = δΣw<sub>mkt</sub> kết hợp quan điểm Q</code>
          <p class="am__needs">Cần: vốn hóa · quan điểm · hiệp phương sai</p>
        </article>
        <article class="am card">
          <div class="am__top"><span class="am__num">3</span><h3>Cân bằng rủi ro</h3></div>
          <p>Mỗi cổ phiếu góp cùng một phần rủi ro. Không cần dự báo lợi suất, nên không có gì để dự báo sai ở phía đó.</p>
          <code class="am__formula">w<sub>i</sub>(Σw)<sub>i</sub> = w<sub>j</sub>(Σw)<sub>j</sub></code>
          <p class="am__needs">Cần: hiệp phương sai</p>
        </article>
        <article class="am card">
          <div class="am__top"><span class="am__num">4</span><h3>Tiêu chí Kelly</h3></div>
          <p>Chọn tỷ trọng tối đa hóa tăng trưởng dài hạn theo lợi thế của bạn. Kelly đủ mức sụt giảm rất sâu, nên dùng nửa Kelly, tối đa 100% vốn.</p>
          <code class="am__formula">f* = ½ Σ⁻¹(μ − r<sub>f</sub>)</code>
          <p class="am__needs">Cần: lợi suất kỳ vọng · hiệp phương sai</p>
        </article>
        <article class="am card">
          <div class="am__top"><span class="am__num">5</span><h3>Phương sai nhỏ nhất</h3></div>
          <p>Tổ hợp biến động thấp nhất có thể. Bỏ qua lợi suất, dồn vào các mã ít biến động, ít tương quan.</p>
          <code class="am__formula">min wᵀΣw</code>
          <p class="am__needs">Cần: hiệp phương sai</p>
        </article>
        <article class="am card">
          <div class="am__top"><span class="am__num">6</span><h3>Tỷ trọng bằng nhau</h3></div>
          <p>Chia đều cho N mã. Ngoài mẫu khó thắng một cách bất ngờ — là mốc mà mọi cách khác phải vượt.</p>
          <code class="am__formula">w<sub>i</sub> = 1 / N</code>
          <p class="am__needs">Cần: không gì cả</p>
        </article>
      </div>

      <figure class="viz card viz--wide">
        <figcaption class="viz__head">
          <div>
            <h3>Cùng sáu cổ phiếu, sáu danh mục khác nhau</h3>
            <p class="muted" id="allocSub">Tỷ trọng chỉ mua theo từng cách</p>
          </div>
          <ul class="viz__legend" id="allocLegend"></ul>
        </figcaption>
        <div class="viz__plot" id="vizAlloc"></div>
        <details class="viz__table"><summary>Xem bảng số liệu</summary><div id="tableAlloc"></div></details>
      </figure>

      <figure class="viz card">
        <figcaption class="viz__head">
          <div>
            <h3>Rủi ro và lợi suất kỳ vọng</h3>
            <p class="muted">Danh mục của từng cách so với đường biên hiệu quả</p>
          </div>
          <ul class="viz__legend">
            <li><i class="key key--line"></i>Đường biên hiệu quả</li>
            <li><i class="key key--num">1</i>Cách phân bổ (đánh số như trên)</li>
            <li><i class="key key--ring"></i>Từng cổ phiếu</li>
          </ul>
        </figcaption>
        <div class="viz__plot" id="vizFrontier"></div>
        <details class="viz__table"><summary>Xem bảng số liệu</summary><div id="tableFrontier"></div></details>
      </figure>
      <p class="viz__source" id="portfolioSource">Mẫu minh họa — không phải khuyến nghị mua các cổ phiếu này.</p>
    </div>
  </section>

  {/* Quy trình */}
  <section id="process" class="section section--alt">
    <div class="container">
      <div class="section__head">
        <p class="eyebrow">Quy trình</p>
        <h2>Từ báo cáo tài chính <em>đến khoảng giá trị</em></h2>
      </div>
      <ol class="steps">
        <li>
          <span class="step__num">01</span>
          <h3>Thu thập</h3>
          <p>Ba năm báo cáo tài chính hợp nhất đã kiểm toán, báo cáo quý gần nhất, báo cáo thường niên và nghị quyết đại hội cổ đông.</p>
        </li>
        <li>
          <span class="step__num">02</span>
          <h3>Chuẩn hóa</h3>
          <p>Loại các khoản bất thường — thanh lý tài sản, hoàn nhập dự phòng, lãi đánh giá lại — để giá trị dựa trên lợi nhuận cốt lõi.</p>
        </li>
        <li>
          <span class="step__num">03</span>
          <h3>Mô hình</h3>
          <p>Liên kết ba báo cáo và dự phóng từ sản lượng, giá bán, biên lợi nhuận — không kéo dài tăng trưởng quá khứ.</p>
        </li>
        <li>
          <span class="step__num">04</span>
          <h3>Kiểm định</h3>
          <p>Bảng độ nhạy cùng ba kịch bản xấu, cơ sở, tốt. Kết quả là một khoảng, không phải một con số.</p>
        </li>
      </ol>
    </div>
  </section>

  {/* Bảng giá */}
  <section id="pricing" class="section">
    <div class="container">
      <div class="section__head section__head--center">
        <p class="eyebrow">Bảng giá</p>
        <h2>Bắt đầu miễn phí, <em>nâng cấp khi cần</em></h2>
      </div>
      <div class="plans">
        <article class="plan card">
          <h3>Cơ bản</h3>
          <p class="plan__price">Miễn phí</p>
          <p class="plan__for">Cho nhà đầu tư mới bắt đầu</p>
          <ul>
            <li>3 báo cáo định giá mỗi tháng</li>
            <li>Công cụ định giá</li>
            <li>Bản tin định giá hằng tuần</li>
          </ul>
          <a class="btn btn--ghost" href="#signup-section">Bắt đầu miễn phí</a>
        </article>
        <article class="plan card plan--featured">
          <span class="plan__badge">Được chọn nhiều nhất</span>
          <h3>Nhà đầu tư</h3>
          <p class="plan__price">199.000 đ<span>/tháng</span></p>
          <p class="plan__for">Cho nhà đầu tư cá nhân nghiêm túc</p>
          <ul>
            <li>Toàn bộ thư viện báo cáo định giá</li>
            <li>File Excel định giá tải về, sửa được</li>
            <li>Thông báo khi giá vào khoảng giá trị</li>
            <li>Phân bổ danh mục với cả sáu cách</li>
            <li>Cập nhật sau mỗi kỳ báo cáo quý</li>
          </ul>
          <a class="btn btn--mint" href="#signup-section">Dùng thử 14 ngày</a>
        </article>
        <article class="plan card">
          <h3>Tổ chức</h3>
          <p class="plan__price">Theo thỏa thuận</p>
          <p class="plan__for">Cho quỹ, công ty chứng khoán, văn phòng gia đình</p>
          <ul>
            <li>Mọi quyền của gói Nhà đầu tư</li>
            <li>API dữ liệu định giá</li>
            <li>Nghiên cứu theo yêu cầu</li>
            <li>Nhiều tài khoản người dùng</li>
          </ul>
          <a class="btn btn--ghost" href="#contact">Liên hệ</a>
        </article>
      </div>
    </div>
  </section>

  {/* Câu hỏi thường gặp */}
  <section id="faq" class="section section--alt">
    <div class="container faq">
      <div class="section__head">
        <p class="eyebrow">Câu hỏi thường gặp</p>
        <h2>Những điều <em>hay được hỏi</em></h2>
      </div>
      <div class="faq__list">
        <details>
          <summary>Giá trị hợp lý có phải giá mục tiêu không?</summary>
          <p>Không. Giá mục tiêu thường gắn với kỳ hạn 12 tháng và kỳ vọng của thị trường. Giá trị hợp lý là ước tính giá trị nội tại dựa trên dòng tiền tương lai — thị trường có thể mất nhiều năm mới phản ánh, hoặc không bao giờ.</p>
        </details>
        <details>
          <summary>Số liệu lấy từ đâu?</summary>
          <p>Báo cáo tài chính đã kiểm toán, báo cáo quý, báo cáo thường niên và tài liệu đại hội cổ đông do doanh nghiệp công bố trên HOSE, HNX và trang quan hệ cổ đông.</p>
        </details>
        <details>
          <summary>Báo cáo được cập nhật bao lâu một lần?</summary>
          <p>Sau mỗi kỳ báo cáo quý, và khi có sự kiện làm đổi giả định cốt lõi — phát hành cổ phiếu, mua bán sáp nhập hay thay đổi quy định ngành.</p>
        </details>
        <details>
          <summary>Định giá ngân hàng thế nào?</summary>
          <p>Bằng thu nhập thặng dư và P/B gắn với ROE bền vững. Với ngân hàng, nợ là nguyên liệu chứ không phải nguồn vốn, nên dòng tiền tự do ít ý nghĩa.</p>
        </details>
        <details>
          <summary>Fairline có khuyến nghị mua, bán không?</summary>
          <p>Không. Chúng tôi công bố khoảng giá trị và mọi giả định để bạn tự đánh giá. Quyết định đầu tư luôn là của bạn.</p>
        </details>
      </div>
    </div>
  </section>

  {/* Liên hệ */}
  <section id="contact" class="section">
    <div class="container contact">
      <div class="contact__info">
        <p class="eyebrow">Liên hệ</p>
        <h2>Trao đổi <em>với chúng tôi</em></h2>
        <p class="lead">Câu hỏi về báo cáo, gói đăng ký hay quyền truy cập cho tổ chức? Gửi tin nhắn cho chúng tôi.</p>
        <div class="contact__card card">
          <span class="contact__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
          </span>
          <div>
            <p class="contact__label">Email hỗ trợ</p>
            <a class="contact__email" href="mailto:support@fairlineresearch.com">support@fairlineresearch.com</a>
            <p class="contact__hint">Báo cáo, tài khoản, thanh toán và gói tổ chức</p>
          </div>
        </div>
        <p class="contact__faq">Câu hỏi nhanh? Có thể đã có trong phần <a href="#faq">câu hỏi thường gặp</a>.</p>
      </div>

      <form class="contact__form card" id="contactForm" data-email="support@fairlineresearch.com">
        <div class="field">
          <label for="contactName">Họ và tên</label>
          <input id="contactName" name="name" type="text" required autocomplete="name">
        </div>
        <div class="field">
          <label for="contactTopic">Chủ đề</label>
          <select id="contactTopic" name="topic">
            <option>Câu hỏi về báo cáo</option>
            <option>Gói đăng ký và thanh toán</option>
            <option>Truy cập cho tổ chức</option>
            <option>Việc khác</option>
          </select>
        </div>
        <div class="field">
          <label for="contactMessage">Lời nhắn</label>
          <textarea id="contactMessage" name="message" rows="5" required></textarea>
        </div>
        <button class="btn btn--primary" type="submit">Gửi tin nhắn →</button>
        <p class="fineprint">Mở ứng dụng email của bạn với tin nhắn soạn sẵn gửi tới support@fairlineresearch.com.</p>
      </form>
    </div>
  </section>

  {/* Đăng ký */}
  <section id="signup-section" class="cta">
    <div class="container cta__inner">
      <div>
        <h2>Mỗi tuần một báo cáo định giá <em>miễn phí</em></h2>
        <p>Một doanh nghiệp, một mô hình, đủ mọi giả định — trong hộp thư sáng thứ Hai.</p>
      </div>
      <form class="signup" id="signup" data-email="support@fairlineresearch.com">
        <label class="sr-only" for="email">Email</label>
        <input id="email" type="email" required placeholder="ban@vidu.com" autocomplete="email">
        <button class="btn btn--mint" type="submit">Đăng ký</button>
        <p class="signup__legal">Bấm Đăng ký sẽ mở ứng dụng email của bạn với thư soạn sẵn; gửi thư đó là xong. Đăng ký là bạn đồng ý với <a href="terms.html">Điều khoản</a> và <a href="privacy.html">Chính sách quyền riêng tư</a>.</p>
        <p class="signup__msg" id="signupMsg" role="status"></p>
      </form>
    </div>
    <div class="cta__bars" aria-hidden="true"><i style="height:46%"></i><i style="height:62%"></i><i style="height:38%"></i><i style="height:74%"></i><i style="height:55%"></i><i style="height:88%"></i><i style="height:48%"></i><i style="height:66%"></i><i style="height:42%"></i><i style="height:80%"></i><i style="height:58%"></i><i style="height:95%"></i><i style="height:52%"></i><i style="height:70%"></i></div>
  </section>
</main>

